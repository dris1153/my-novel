# Root .env — CHỈ cho crawler cục bộ (packages/crawler). Copy thành .env.
# service_role bypass toàn bộ RLS — KHÔNG bao giờ commit, KHÔNG bao giờ đưa vào
# app mobile/admin. File .env đã bị gitignore.

SUPABASE_URL=
# Dashboard → Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — cùng bucket admin dùng cho ảnh bìa
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=novel-covers
R2_PUBLIC_URL=https://covers.example.com
